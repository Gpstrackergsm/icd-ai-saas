{
  "compilerOptions": {
    "outDir": "dist",
    "module": "commonjs",
    "target": "es2019",
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "strict": true,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "lib": [
      "ES2021"
    ]
  },
  "include": [
    "lib/**/*",
    "api/**/*",
    "data/**/*",
    "public/**/*",
    "*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "lib/icd-core/icdTextParser.ts",
    "debug_*.ts",
    "test_*.ts",
    "run_*.ts",
    "show_*.ts",
    "audit_*.ts",
    "strict_*.ts"
  ]
}